{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/health" },
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/data/:file*", "destination": "/docs/data/:file*" }
  ]
}
